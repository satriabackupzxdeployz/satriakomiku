{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/public/index.html"
    },
    {
      "source": "/manga",
      "destination": "/public/index.html"
    },
    {
      "source": "/manhwa",
      "destination": "/public/index.html"
    },
    {
      "source": "/manhua",
      "destination": "/public/index.html"
    },
    {
      "source": "/favoritku",
      "destination": "/public/index.html"
    }
  ]
}